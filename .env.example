# ─────────────────────────────────────────────────────────────────────────────
# Erty configuration
# Copy this file to .env, fill it in, then run: php artisan erty:install
# After changing .env in production, run: php artisan config:cache
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Erty
# local while developing; production on a live server (hides error details, forces HTTPS links)
APP_ENV=local
# Generated by `php artisan erty:install` (or `php artisan key:generate`). Keep it secret and never change
# it on a live installation: it encrypts sessions and the links Erty sends.
APP_KEY=
# true only while developing: shows full error pages
APP_DEBUG=true
# The address people open Erty at, without a trailing slash (used in emails and links)
APP_URL=http://localhost
# Timezone for dates, rent billing and the nightly jobs (a PHP timezone name, e.g. Africa/Nairobi, Europe/London)
APP_TIMEZONE=Africa/Nairobi

# ── Branding and contacts ────────────────────────────────────────────────────
# Logo shown in the app, as a path under public/
APP_LOGO=include/dashboard/media/logos/erty.svg
# Shown to users as the support contact, and copied on every new support ticket; leave empty for neither
SUPPORT_EMAIL=
# Published at /.well-known/security.txt for security reports; leave empty to not publish the file
SECURITY_EMAIL=
# Security alerts (blocked addresses), account-deletion reports and backup alerts; leave empty to send none
NOTIFICATION_EMAIL=

# ── First installation (php artisan erty:install) ────────────────────────────
# The first administrator. Sign-in emails a 6-digit code to this address, so use a mailbox you can read.
# Their password is shown once by the install command and must be changed at the first sign-in.
ADMIN_EMAIL=
# The business name; empty means APP_NAME
BUSINESS_NAME=

# ── Money ────────────────────────────────────────────────────────────────────
# ISO currency code for amounts that carry none of their own, and the symbol shown beside amounts
ERTY_CURRENCY=KES
CURRENCY_SYMBOL=KSh
# Optional exchange rates, used when totals mix currencies (an ExchangeRate-API compatible service:
# EXCHANGE_RATE_API=https://v6.exchangerate-api.com/v6). Leave both empty to count every rate as 1.
EXCHANGE_RATE_API=
EXCHANGE_RATE_API_KEY=

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=erty
# The Postgres schema Erty's tables live in (its search_path)
DB_SCHEMA=public
DB_USERNAME=postgres
DB_PASSWORD=

# ── Email ────────────────────────────────────────────────────────────────────
# Sign-in codes, invitations, tenant statements and notifications are sent by email.
# While developing, MAIL_MAILER=log writes every email (and its sign-in code) to storage/logs.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls or ssl as your mail provider requires; empty for none
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Sessions, cache, queue and logs ──────────────────────────────────────────
# Sessions are kept in the database (the sessions table); minutes of inactivity before signing out
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set to true when Erty is served over HTTPS, so the session cookie is never sent unencrypted
SESSION_SECURE_COOKIE=false
CACHE_DRIVER=file
# sync runs emails and other jobs straight away; use database (with `php artisan queue:work`) to run them
# in the background
QUEUE_CONNECTION=sync
# daily keeps one log file per day in storage/logs
LOG_CHANNEL=daily

# ── Files ────────────────────────────────────────────────────────────────────
# Uploaded files (photos, floor plans, tenant and legal documents) are stored on the "public" disk under
# storage/app/public; `php artisan erty:install` links it to public/storage.
FILESYSTEM_DRIVER=local
# Optional: Amazon S3 credentials, only needed if you move files or backups to S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# ── Security ─────────────────────────────────────────────────────────────────
# Strict-Transport-Security on HTTPS responses: how long browsers remember to use HTTPS only (seconds)
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
# Requests for pages that do not exist: an address making more than MAX_ATTEMPTS such requests within
# DECAY_MINUTES minutes is blocked
MAX_ATTEMPTS=2
DECAY_MINUTES=1
# Extra websocket sources allowed by the Content-Security-Policy; empty means this site only
CSP_WEBSOCKET_SOURCES=

# ── Activity log ─────────────────────────────────────────────────────────────
# Who opened, changed or downloaded what, and sign-ins. Entries older than this are removed every night.
ACTIVITY_LOG_KEEP_DAYS=365

# ── Backups (spatie/laravel-backup) ──────────────────────────────────────────
# Optional password for the backup zip files made each night by `php artisan backup:run`
BACKUP_ARCHIVE_PASSWORD=

# ── Public listings API (GET /api/v1/listings) ───────────────────────────────
# Requests per minute allowed from one address
LISTINGS_API_RATE_LIMIT=60
